# ─────────────────────────────────────────────────────────────────────────────
# Engineering Data Playground — Backend Environment Variables
#
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5000

# ─── Option A: Cloud PostgreSQL (Neon, Supabase, etc.) ───────────────────────
# If DATABASE_URL is set, it takes priority over the individual vars below.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Option B: Local Docker PostgreSQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=data_playground

# ─── Frontend URL (for CORS) ──────────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Kafka ────────────────────────────────────────────────────────────────────
# Local Docker Kafka (KRaft mode): localhost:9092
# KAFKA_BROKER=localhost:9092
